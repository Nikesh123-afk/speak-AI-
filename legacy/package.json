{
  "name": "ielts-fluent-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack IELTS speaking practice platform",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:migrate:prod": "node dist/server/migrate.js",
    "test": "tsx --test --test-isolation=none tests/*.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
