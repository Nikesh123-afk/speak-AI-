# Copy to .env. Everything is optional for local development.
APP_ENV=development
# Origin users load the site from. Dev: the Vite server. Production: your https:// domain.
APP_ORIGIN=http://localhost:5173
# PostgreSQL URL. Leave empty in development to use the embedded local server in .data/pg.
DATABASE_URL=
SESSION_DAYS=30
LOG_LEVEL=INFO

# AI feedback (https://aistudio.google.com/apikey). Without it, feedback is switched off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stripe. Paid plans stay unavailable until all four are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# docker compose only
POSTGRES_PASSWORD=
