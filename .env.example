# Copy to .env. Everything is optional for local development.
APP_ENV=development
# Origin users load the site from. Dev: the Vite server. Production: your https:// domain.
APP_ORIGIN=http://localhost:5173
# PostgreSQL URL. Leave empty in development to use the embedded local server in .data/pg.
DATABASE_URL=
SESSION_DAYS=30
LOG_LEVEL=INFO

# AI feedback (https://aistudio.google.com/apikey). Without it, feedback is switched off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stripe. Paid plans stay unavailable until all four are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Signs newsletter confirm/unsubscribe links. Production: a random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=

# Outgoing email: password reset, email confirmation, newsletter. Required in production.
# Without SMTP_HOST in development, emails (with their links) are printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM="IELTS Fluent AI <hello@example.com>"

# Shown on the contact page and in the footer. Premium's "priority email support" goes here.
SUPPORT_EMAIL=
# Comma-separated emails that can open /admin (each must also confirm its address).
ADMIN_EMAILS=
# Error monitoring (https://sentry.io). Request bodies, local variables and PII are never sent.
SENTRY_DSN=

# docker compose only
POSTGRES_PASSWORD=
